# Copy this file and name the copy ".env" (the README shows how).

# Port the server listens on.
PORT=5000

# Where MongoDB lives. This is the same address you connect to in MongoDB Compass.
MONGO_URI=mongodb://127.0.0.1:27017/bookverse

# Secret used to sign login tokens. Change it to any long random text.
JWT_SECRET=change-me-to-a-long-random-secret

# Admin account created by "npm run seed".
ADMIN_EMAIL=admin@bookverse.com
ADMIN_PASSWORD=Admin@123
